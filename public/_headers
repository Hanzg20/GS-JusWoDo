# Cloudflare Pages Headers Configuration
# This file configures HTTP headers for the PWA deployment

# Global headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()

# Service Worker must not be cached and has correct scope
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Workbox precache Service Worker
/workbox-*.js
  Cache-Control: public, max-age=0, must-revalidate

# Web App Manifest
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, must-revalidate

# Static assets - long cache with immutability
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PWA Icons - medium cache
/pwa-icons/*
  Cache-Control: public, max-age=86400

# Fonts - long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
